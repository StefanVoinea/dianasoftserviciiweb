APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vuexy_bootstrap_vue_laravel_template
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Pe serverele cu porturile SMTP blocate de gazduire (cloud), emailurile pleaca
# prin API-ul HTTP ZeptoMail (Zoho): MAIL_MAILER=zeptomail si cheia de mai jos
# (ZeptoMail -> Mail Agents -> Send Mail Token, fara prefixul "Zoho-enczapikey").
#ZEPTOMAIL_KEY=
#ZEPTOMAIL_URL=https://api.zeptomail.eu/v1.1/email

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SPV_DRIVER=bridge
SPV_BASE_URL=https://webserviced.anaf.ro/SPVWS2/rest
SPV_BRIDGE_URL=http://127.0.0.1:8099
SPV_BRIDGE_TOKEN=
SPV_CERT_THUMBPRINT=
SPV_CERT_PATH=
SPV_CERT_PASSWORD=
SPV_CA_BUNDLE=
SPV_DISK=local

ANAF_JAVA_BIN=java
# Calea completa catre DUKIntegrator.jar. Langa el trebuie sa stea „config” si
# „lib”, fiindca actualizarea de noapte (anaf:duk-update) scrie acolo.
#   pe server:  /home/forge/anaf-tools/dist/DUKIntegrator.jar
#   pe windows: C:\cale\catre\anaf-tools\dist\DUKIntegrator.jar
ANAF_DUK_JAR=
ANAF_URL_DEPUNERE=https://decl.anaf.mfinante.gov.ro

# e-Transport: "certificat" foloseste tokenul prin programul local, "oauth" apeleaza direct ANAF
ETRANSPORT_MOD=certificat
ETRANSPORT_MEDIU=prod
ETRANSPORT_VERSIUNE=2

# Datele de client OAuth2, obtinute la inregistrarea aplicatiei in SPV.
# Adresa de retur trebuie sa fie identica cu cea declarata la ANAF.
CLIENT_ANAF_ID=
CLIENT_ANAF_SECRET=
ANAF_OAUTH_REDIRECT=

# Portal Just: cat de des se verifica dosarele urmarite si cat se pastreaza istoricul
PORTAL_JUST_PAUZA_MS=500
PORTAL_JUST_ZILE_ISTORIC=365

# Firebase Cloud Messaging — alertele instantanee in aplicatia Android.
# Fara ele, aplicatia mobila ramane pe verificarea periodica proprie.
# Cheia contului de serviciu: consola Firebase > Project settings >
# Service accounts > Generate new private key (fisier JSON, tinut in afara depozitului).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Validatorul ANAF pentru D406/SAF-T. Fara el, declaratia se compara cu
# nomenclatoarele din 2019 si apar erori care nu exista (vezi tools/duk-d406).
# Gol = se cauta DukD406.jar langa DUKIntegrator.jar.
ANAF_DUK_JAR_D406=

# Contul care vede „Administrare clienti"
SUPER_ADMIN_EMAIL=

# Arhiva de documente de la client, prin programul local
ANAF_ARHIVA_ACTIVA=true
ANAF_ARHIVA_STERGE_SERVER=true

# Unde ajung instiintarile despre erori (client, certificat, context, ce e de
# facut). Lasate goale, se folosesc valorile din config/anaf.php: adresa de mai
# jos si o racire de 30 de minute, cat sa nu se trimita aceeasi eroare de doua
# ori la rand.
ANAF_ALERTE_EMAIL=stefan.voinea@gmail.com
ANAF_ALERTE_RACIRE_MINUTE=30

# Calea catre wkhtmltopdf/wkhtmltoimage (rapoartele PDF). Nesetate, se folosesc
# caile de Windows din config/snappy.php. Pe serverele Linux:
# WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
# WKHTML_IMG_BINARY=/usr/local/bin/wkhtmltoimage
